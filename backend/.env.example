# =====================================================
# Lumina Host — Backend (.env.example)
# Copie este arquivo para `.env` antes de rodar.
# =====================================================

# PostgreSQL — sobe via docker-compose (lumina-postgres na porta 5439 localmente;
# ajuste se essa porta já estiver em uso na sua máquina).
DATABASE_URL="postgresql://postgres:lumina_dev_2024@localhost:5439/lumina_host?schema=public"

# JWT — em PRODUÇÃO troque por segredos aleatórios (gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — domínios permitidos (separados por vírgula). Subdomínios
# *.easypanel.host são aceitos automaticamente em produção.
ALLOWED_ORIGINS="http://localhost:8080"

# Server (em produção no EasyPanel, use PORT=3001 — ver .docs/DEPLOY-EASYPANEL.md)
PORT=3003
NODE_ENV="development"
